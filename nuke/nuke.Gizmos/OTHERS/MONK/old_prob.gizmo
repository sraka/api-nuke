 addUserKnob {26 ""}
 addUserKnob {26 AdjustLightAOVs l "Adjust Light AOVs"}
 addUserKnob {6 BeautySwitch l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {16 Volume l "Volume Light"}
