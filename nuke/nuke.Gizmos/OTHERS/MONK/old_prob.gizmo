version 12.0 v4
Gizmo {
 knobChanged "\nthis_node = nuke.thisNode()\nthis_knob = nuke.thisKnob()\nif this_knob.name() == \"inputChange\" and this_node.inputs():\n    input_node = this_node.input(0)\n    channel_array = list(set(\[channel_name.split('.')\[0] for channel_name in input_node.channels()]))\n    lighting_grp_types = list(set(\[channel_name.split('_', 1)\[1] for channel_name in channel_array if channel_name.startswith('Beauty')]))\n    lighting_grp_types.sort()\n    nuke.thisNode()\['LightingGrpArray'].setValues(lighting_grp_types)\n    lighting_grp_type = this_node.knob('LightingGrpArray').value()\n    pass_channels = \['DiffuseLighting', 'GI', 'Reflections', 'Refractions', 'SSS', 'SpecularLighting', 'Emission',  'VolumeLighting', 'Beauty']\n    for pass_channel in pass_channels:\n        channel_name = '_'.join(\[pass_channel, lighting_grp_type])\n        keep_node= this_node.node('_'.join(\[pass_channel, 'keep']))\n        keep_node.knob('channels').setValue(channel_name)\n        shuffe_node = this_node.node('_'.join(\[pass_channel, 'shuffle']))\n        shuffe_node.knob('in').setValue(channel_name)    \n\nif this_knob.name() == \"LightingGrpArray\":\n    lighting_grp_type = this_knob.value()\n    pass_channels = \['DiffuseLighting', 'GI', 'Reflections', 'Refractions', 'SSS', 'SpecularLighting', 'Emission', 'VolumeLighting', 'Beauty']\n    for pass_channel in pass_channels:\n        channel_name = '_'.join(\[pass_channel, lighting_grp_type])\n        keep_node= this_node.node('_'.join(\[pass_channel, 'keep']))\n        keep_node.knob('channels').setValue(channel_name)\n        shuffe_node = this_node.node('_'.join(\[pass_channel, 'shuffle']))\n        shuffe_node.knob('in').setValue(channel_name)\n"
 tile_color 0xff3fff
 label "\[python nuke.thisNode().knob('LightingGrpArray').value()]"
 addUserKnob {20 User}
 addUserKnob {22 CopyValues l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {22 PasteValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {22 ResetValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {22 ExportValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {26 d l INVISIBLE +INVISIBLE}
 addUserKnob {6 ByPassAll l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {20 LightingGroup l LightingGroupType n 1}
 addUserKnob {4 LightingGrpArray l LightingGrpType M {Candle1 Candle2 Candle3 Lighting_Key layer2}}
 LightingGrpArray Candle2
 addUserKnob {20 LightingGrpEndGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {20 ArtDirected l "Color " n 1}
 addUserKnob {4 colorMode l "Color Mode" M {Color Temperature "Temperature & Color" ""}}
 addUserKnob {26 ColorHelp l "" +STARTLINE T "(Color Only for Env & Portals, Color/Temperature ONLY IES Lights)"}
 addUserKnob {6 ByPassColor l "By Pass" +STARTLINE}
 addUserKnob {18 LightColor l "Color(USE COLOR WHEEL)" t "(USE COLOR WHEEL)"}
 LightColor {1 1 1}
 addUserKnob {6 LightColor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 LightColor_panelDropped true
 addUserKnob {26 ""}
 addUserKnob {41 ChooseLight l ColorTemperature T Color_Temperature_tool7.ChooseLight}
 addUserKnob {26 hint l "(DO NOT use on ENV and PORTAL LIGHTS)" -STARTLINE}
 addUserKnob {20 endGroup_2 l endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {20 LightAdjust l "Light Adjust" n 1}
 addUserKnob {6 ByPassIntensity l "By Pass" +STARTLINE}
 addUserKnob {16 Intensity}
 Intensity 1
