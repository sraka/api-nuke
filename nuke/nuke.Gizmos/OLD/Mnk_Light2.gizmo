#! C:/Program Files/Nuke12.0v4/nuke-12.0.4.dll -nx
version 12.0 v4
Gizmo {
 tile_color 0xff3fff
 label "\[value light]"
 addUserKnob {20 User}
 addUserKnob {22 CopyValues l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {22 PasteValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {22 ResetValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {22 ExportValues l INVISIBLE -STARTLINE +INVISIBLE}
 addUserKnob {26 d l INVISIBLE +INVISIBLE}
 addUserKnob {6 ByPassAll l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {20 LightingGroup l LightingGroupType n 1}
 addUserKnob {22 Analyse_AOVs l "Analyse AOVs" -STARTLINE T "this_node = nuke.thisNode()\nlight_knob = this_node.knob('light')\n\nif this_node.inputs():\n    input_node = this_node.input(0)\n    channel_array = list(set(\[channel_name.split('.')\[0] for channel_name in input_node.channels()]))\n    lighting_grp_types = list(set(\[channel_name.split('_', 1)\[1] for channel_name in channel_array if channel_name.startswith('Beauty')]))\n    lighting_grp_types.sort()\n    light_knob.setValues(lighting_grp_types)  \nelse:\n    nuke.message(\"No Input Node Connected to this gizmo, please connect a read node\")"}
 addUserKnob {4 light l "<font color='lightgreen'>light </font>" M {bounce env_dome env_portal floorkey key other rimL rimR ""}}
 addUserKnob {4 LightingGrpArray l "<font color='yellow'>LightingGrpType </font>" +INVISIBLE M {"" "" "" ""}}
 addUserKnob {22 Set_AOVs l Set -STARTLINE T "import nuke\nnuke.DO_NOT_WRITE = 0\nnuke.SAVE_MENU = 1\n\nthis_node = nuke.thisNode()\nlight_knob = this_node.knob('light')\nlight_knob_value = light_knob.value()\npass_channels = \['DiffuseLighting', 'GI', 'Reflections', 'Refractions', 'SSS', 'SpecularLighting', 'Emission', 'VolumeLighting', 'Beauty']\nfor each_channel in pass_channels:\n    channel_name = '_'.join(\[each_channel, light_knob_value]) # Beauty_Candle1\n    keep_node= this_node.node('_'.join(\[each_channel, 'keep'])) # NodeName: Beauty_keep\n    keep_node.knob('channels').setValue(channel_name) \n    shuffe_node = this_node.node('_'.join(\[each_channel, 'shuffle'])) # NodeName: Beauty_shuffle\n    shuffe_node.knob('in').setValue(channel_name)\n\n"}
 addUserKnob {20 LightingGrpEndGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {20 ArtDirected l "Color " n 1}
 addUserKnob {4 colorMode l "Color Mode" M {Color Temperature "Temperature & Color" ""}}
 colorMode "Temperature & Color"
 addUserKnob {26 ColorHelp l "" +STARTLINE T "(Color Only for Env & Portals, Color/Temperature ONLY IES Lights)"}
 addUserKnob {6 ByPassColor l "By Pass" +STARTLINE}
 addUserKnob {18 LightColor l "Color(USE COLOR WHEEL)" t "(USE COLOR WHEEL)"}
 LightColor {0 1 1}
 addUserKnob {6 LightColor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 LightColor_panelDropped true
 addUserKnob {26 ""}
 addUserKnob {41 ChooseLight l ColorTemperature T Color_Temperature_tool7.ChooseLight}
 addUserKnob {26 hint l "(DO NOT use on ENV and PORTAL LIGHTS)" -STARTLINE}
 addUserKnob {20 endGroup_2 l endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {20 LightAdjust l "Light Adjust" n 1}
 addUserKnob {6 ByPassIntensity l "By Pass" +STARTLINE}
 addUserKnob {16 Intensity}
 Intensity 1
 addUserKnob {7 Exposure l INVISIBLE +INVISIBLE R -1 1}
 addUserKnob {26 ""}
 addUserKnob {26 AdjustLightAOVs l "Adjust Light AOVs"}
 addUserKnob {6 BeautySwitch l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {16 Volume l "Volume Light"}
 Volume 1
 addUserKnob {16 Diffuse}
 Diffuse 1
 addUserKnob {16 Specular}
 Specular 1
 addUserKnob {16 SSS}
 SSS 1
 addUserKnob {16 GI}
 GI 1
 addUserKnob {26 NOT l "NoT Transferable To Maya"}
 addUserKnob {16 Emission}
 Emission 1
 addUserKnob {16 Reflection}
 Reflection 1
 addUserKnob {16 Refraction}
 Refraction 1
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {26 ArtiDirected l INVISIBLE +INVISIBLE}
 addUserKnob {26 NOTE l INVISIBLE +INVISIBLE}
 addUserKnob {41 random l INVISIBLE +INVISIBLE T randomizegrade.random}
 addUserKnob {26 Redshift_nukelightingtool l "" +STARTLINE T "Redshift Light_v008,  AQ"}
}
