Group {
 name KSMB
 selected true
 xpos 8
 ypos -123
 addUserKnob {20 User}
 addUserKnob {3 KronosDriver_input.first l "Input Range"}
 KronosDriver_input.first 1
 addUserKnob {3 KronosDriver_input.last l "" -STARTLINE R 0 100}
 KronosDriver_input.last 200
 addUserKnob {26 lastHint l "" -STARTLINE T "Last Frame = Input Last Frame X 2"}
 addUserKnob {8 KronosDriver_vectorDetail l "Vector Detail" R 0.01 1}
 KronosDriver_vectorDetail 1
 addUserKnob {8 KronosDriver_smoothness l Smoothness R 0.01 1}
 KronosDriver_smoothness 0.2
 addUserKnob {3 KronosDriver_shutterSamples l "Shutter Samples" R 0 20}
 KronosDriver_shutterSamples 10
 addUserKnob {8 KronosDriver_shutterTime l "Shutter Time" R 0 10}
 KronosDriver_shutterTime 2
 addUserKnob {6 DoubleDown l "Double Down" +STARTLINE}
 DoubleDown true
 addUserKnob {6 TripleDown l "Triple Down" -STARTLINE}
 TripleDown true
}
 Input {
  inputs 0
  name Plate
  xpos -540
  ypos 106
 }
 FrameHold {
  first_frame {{ceil(frame/2)}}
  name FrameHold8
  xpos -540
  ypos 170
  addUserKnob {20 Set_This_Frame l SetThisFrame}
  addUserKnob {22 SetThisFrame -STARTLINE T "node =\nnuke.thisNode()\n\nnode\['first_frame'].setValue(nuke.frame()) "}
  addUserKnob {22 setCurrentFrame l "Set current frame" -STARTLINE T "import nuke\nnuke.thisNode()\['first_frame'].setValue(nuke.frame())"}
 }
 Kronos {
  input.first {{parent.KronosDriver_input.first}}
  input.last {{parent.KronosDriver_input.last}}
  timingSpeed 2
  vectorDetail {{parent.KronosDriver_vectorDetail}}
  smoothness {{parent.KronosDriver_smoothness}}
  Shutter 1
  shutterSamples {{parent.KronosDriver_shutterSamples}}
  shutterTime {{parent.KronosDriver_shutterTime}}
  Advanced 1
  Tolerances 1
  vectorSpacing 1
  name KronosDriver
  selected true
  xpos -540
  ypos 265
 }
