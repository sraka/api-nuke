Gizmo {
 inputs 0
 name D_DeepFromDistance
 tile_color 0x5fff
 addUserKnob {20 PbcToDeep}
 addUserKnob {41 in l "Distance Channel" t "choose the channel where the distance values are" T Shuffle1.in}
 addUserKnob {4 DistanceColour l "Distance Colour" t "choose which colour carries the distance information" M {red green blue ""}}
 addUserKnob {6 UnpremultDistance l "Unpremult Distance" t "Your distance channel should unpremultiplied.\nTick this box if it isn't already." +STARTLINE}
 UnpremultDistance true
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {26 copyright l "" +STARTLINE T "D_DeepFromDistance v1.0 - (c) 2013 - Denis Scolan"}
}
 Input {
  inputs 0
  name InputImg
  xpos 512
  ypos -534
 }
set N14e70290 [stack 0]
 Shuffle {
  red alpha
  green alpha
  blue alpha
  name Shuffle2
  xpos 900
  ypos -460
 }
 Unpremult {
  name Unpremult1
  xpos 900
  ypos -189
 }
push $N14e70290
 Shuffle {
  in2 rgba
  alpha alpha2
  name Shuffle1
  xpos 703
  ypos -461
 }
 Unpremult {
  name Unpremult2
  xpos 703
  ypos -404
  disable {{1-UnpremultDistance}}
 }
set N229648d0 [stack 0]
 Shuffle {
  red blue
  green blue
  name Shuffle5
  xpos 819
  ypos -322
 }
push $N229648d0
 Shuffle {
  red green
  blue green
  name Shuffle4
  xpos 703
  ypos -326
 }
push $N229648d0
 Shuffle {
  green red
  blue red
  name Shuffle3
  xpos 596
  ypos -322
 }
 Switch {
  inputs 3
  which {{DistanceColour}}
  name Switch1
  xpos 703
  ypos -249
 }
 Expression {
  inputs 1+1
  channel0 depth
  expr0 1/rgba.red
  channel1 none
  channel2 none
  channel3 none
  maskChannelMask rgba.red
  name Expression1
  selected true
  xpos 703
  ypos -189
 }
 Clamp {
  name Clamp1
  xpos 703
  ypos -143
 }
push $N14e70290
 Remove {
  channels depth
  name Remove1
  xpos 512
  ypos -470
 }
 Copy {
  inputs 2
  channels depth
  bbox B
  name Copy1
  xpos 512
  ypos -149
 }
 DeepFromImage {
  premult true
  name DeepFromImage3
  xpos 512
  ypos -44
 }
 Output {
  name Output1
  xpos 512
  ypos 25
 }
end_group
